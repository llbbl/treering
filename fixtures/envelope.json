{
  "suite": "envelope",
  "spec": "0.1.0-draft",
  "cases": [
    {
      "id": "envelope/json-field-order",
      "description": "JSON keys appear in the normative order regardless of the language's map ordering",
      "spec_ref": "§2.2",
      "pending": false,
      "input": {
        "timestamp": "2026-08-22T04:15:30.123Z",
        "runtime": "node",
        "level": "info",
        "message": "User logged in",
        "metadata": {
          "userId": 123
        },
        "format": "json"
      },
      "expect": {
        "json": "{\"timestamp\":\"2026-08-22T04:15:30.123Z\",\"level\":\"info\",\"message\":\"User logged in\",\"runtime\":\"node\",\"metadata\":{\"userId\":123}}"
      }
    },
    {
      "id": "envelope/json-metadata-omitted",
      "description": "Absent metadata omits the key entirely rather than emitting null or {}",
      "spec_ref": "§2.4",
      "pending": false,
      "input": {
        "timestamp": "2026-08-22T04:15:30.123Z",
        "runtime": "node",
        "level": "warn",
        "message": "disk almost full",
        "format": "json"
      },
      "expect": {
        "json": "{\"timestamp\":\"2026-08-22T04:15:30.123Z\",\"level\":\"warn\",\"message\":\"disk almost full\",\"runtime\":\"node\"}",
        "omits": [
          "metadata"
        ]
      }
    },
    {
      "id": "envelope/json-empty-metadata-omitted",
      "description": "Metadata that is empty after merging is treated identically to absent metadata",
      "spec_ref": "§2.4",
      "pending": false,
      "input": {
        "timestamp": "2026-08-22T04:15:30.123Z",
        "runtime": "node",
        "level": "info",
        "message": "ping",
        "metadata": {},
        "format": "json"
      },
      "expect": {
        "json": "{\"timestamp\":\"2026-08-22T04:15:30.123Z\",\"level\":\"info\",\"message\":\"ping\",\"runtime\":\"node\"}",
        "omits": [
          "metadata"
        ]
      }
    },
    {
      "id": "envelope/text-basic",
      "description": "Text form uppercases the level and brackets the timestamp",
      "spec_ref": "§2.5",
      "pending": false,
      "input": {
        "timestamp": "2026-08-22T04:15:30.123Z",
        "runtime": "node",
        "level": "info",
        "message": "User logged in",
        "metadata": {
          "userId": 123
        },
        "format": "text"
      },
      "expect": {
        "text": "[2026-08-22T04:15:30.123Z] INFO: User logged in {\"userId\":123}"
      }
    },
    {
      "id": "envelope/text-no-metadata",
      "description": "Without metadata there is no trailing space",
      "spec_ref": "§2.5",
      "pending": false,
      "input": {
        "timestamp": "2026-08-22T04:15:30.123Z",
        "runtime": "node",
        "level": "error",
        "message": "connection refused",
        "format": "text"
      },
      "expect": {
        "text": "[2026-08-22T04:15:30.123Z] ERROR: connection refused"
      }
    },
    {
      "id": "envelope/case-asymmetry",
      "description": "JSON lowercases the level while text uppercases it; this asymmetry is normative",
      "spec_ref": "§2.5",
      "pending": false,
      "input": {
        "timestamp": "2026-08-22T04:15:30.123Z",
        "runtime": "deno",
        "level": "warn",
        "message": "deprecated",
        "format": "both"
      },
      "expect": {
        "json": "{\"timestamp\":\"2026-08-22T04:15:30.123Z\",\"level\":\"warn\",\"message\":\"deprecated\",\"runtime\":\"deno\"}",
        "text": "[2026-08-22T04:15:30.123Z] WARN: deprecated"
      }
    },
    {
      "id": "envelope/empty-message",
      "description": "An empty message is valid and is not elided",
      "spec_ref": "§2.1",
      "pending": false,
      "input": {
        "timestamp": "2026-08-22T04:15:30.123Z",
        "runtime": "node",
        "level": "info",
        "message": "",
        "format": "both"
      },
      "expect": {
        "json": "{\"timestamp\":\"2026-08-22T04:15:30.123Z\",\"level\":\"info\",\"message\":\"\",\"runtime\":\"node\"}",
        "text": "[2026-08-22T04:15:30.123Z] INFO: "
      }
    },
    {
      "id": "envelope/metadata-substitutions-apply",
      "description": "Value substitutions from SPEC §4 apply to metadata inside the envelope",
      "spec_ref": "§2.2",
      "pending": false,
      "input": {
        "timestamp": "2026-08-22T04:15:30.123Z",
        "runtime": "node",
        "level": "error",
        "message": "handler failed",
        "metadata": {
          "err": {
            "$error": {
              "name": "Error",
              "message": "boom",
              "stack": "<STACK>"
            }
          }
        },
        "format": "json"
      },
      "expect": {
        "json": "{\"timestamp\":\"2026-08-22T04:15:30.123Z\",\"level\":\"error\",\"message\":\"handler failed\",\"runtime\":\"node\",\"metadata\":{\"err\":{\"name\":\"Error\",\"message\":\"boom\",\"stack\":\"<STACK>\"}}}"
      }
    },
    {
      "id": "envelope/timestamp-disabled",
      "description": "config.timestamp=false omits the timestamp from the text form",
      "spec_ref": "§6.4",
      "pending": false,
      "input": {
        "timestamp": "2026-08-22T04:15:30.123Z",
        "runtime": "node",
        "level": "info",
        "message": "no clock",
        "format": "text",
        "config": {
          "timestamp": false
        }
      },
      "expect": {
        "text": "INFO: no clock"
      }
    },
    {
      "id": "envelope/colorize-never-affects-json",
      "description": "colorize applies only to the text form; JSON is never colorized",
      "spec_ref": "§6.4",
      "pending": false,
      "input": {
        "timestamp": "2026-08-22T04:15:30.123Z",
        "runtime": "node",
        "level": "error",
        "message": "red",
        "format": "json",
        "config": {
          "colorize": true
        }
      },
      "expect": {
        "json": "{\"timestamp\":\"2026-08-22T04:15:30.123Z\",\"level\":\"error\",\"message\":\"red\",\"runtime\":\"node\"}"
      }
    }
  ]
}
