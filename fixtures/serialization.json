{
  "suite": "serialization",
  "spec": "0.1.0-draft",
  "cases": [
    {
      "id": "serialization/plain",
      "description": "Ordinary values pass through unchanged, in insertion order",
      "spec_ref": "§4.3",
      "pending": false,
      "input": { "value": { "b": 1, "a": "two", "c": true, "d": null } },
      "expect": { "json": "{\"b\":1,\"a\":\"two\",\"c\":true,\"d\":null}" }
    },
    {
      "id": "serialization/circular-self",
      "description": "An object that references itself emits [Circular] at the cycle",
      "spec_ref": "§4",
      "pending": false,
      "input": {
        "value": { "$id": "root", "value": { "name": "root", "self": { "$ref": "root" } } }
      },
      "expect": { "json": "{\"name\":\"root\",\"self\":\"[Circular]\"}" }
    },
    {
      "id": "serialization/circular-indirect",
      "description": "A cycle through an intermediate object is still a cycle",
      "spec_ref": "§4",
      "pending": false,
      "input": {
        "value": {
          "$id": "a",
          "value": { "name": "a", "child": { "name": "b", "parent": { "$ref": "a" } } }
        }
      },
      "expect": { "json": "{\"name\":\"a\",\"child\":{\"name\":\"b\",\"parent\":\"[Circular]\"}}" }
    },
    {
      "id": "serialization/repeated-not-circular",
      "description": "The same object appearing twice as siblings is NOT circular and must serialize in full both times",
      "spec_ref": "§4.1",
      "pending": true,
      "pending_reason": "OQ-1. The reference implementation marks all visited objects and never unwinds, so the second occurrence emits [Circular].",
      "input": {
        "value": {
          "shared": { "$id": "u", "value": { "id": 7 } },
          "first": { "$ref": "u" },
          "second": { "$ref": "u" }
        }
      },
      "expect": { "json": "{\"shared\":{\"id\":7},\"first\":{\"id\":7},\"second\":{\"id\":7}}" }
    },
    {
      "id": "serialization/function-named",
      "description": "A named callable is replaced by its name",
      "spec_ref": "§4",
      "pending": false,
      "input": { "value": { "cb": { "$fn": "handleRequest" } } },
      "expect": { "json": "{\"cb\":\"[Function: handleRequest]\"}" }
    },
    {
      "id": "serialization/function-anonymous",
      "description": "An unnamed callable is reported as anonymous",
      "spec_ref": "§4",
      "pending": false,
      "input": { "value": { "cb": { "$fn": null } } },
      "expect": { "json": "{\"cb\":\"[Function: anonymous]\"}" }
    },
    {
      "id": "serialization/undefined",
      "description": "An absent value is preserved as a marker rather than dropped",
      "spec_ref": "§4",
      "pending": false,
      "input": { "value": { "missing": { "$undefined": true } } },
      "expect": { "json": "{\"missing\":\"[undefined]\"}" }
    },
    {
      "id": "serialization/bigint",
      "description": "Integers beyond native JSON range are stringified with a marker",
      "spec_ref": "§4",
      "pending": false,
      "input": { "value": { "n": { "$bigint": "9007199254740993" } } },
      "expect": { "json": "{\"n\":\"[BigInt: 9007199254740993]\"}" }
    },
    {
      "id": "serialization/symbol",
      "description": "An interned atom is stringified with its description",
      "spec_ref": "§4",
      "pending": false,
      "input": { "value": { "s": { "$symbol": "mySymbol" } } },
      "expect": { "json": "{\"s\":\"[Symbol: Symbol(mySymbol)]\"}" }
    },
    {
      "id": "serialization/error-basic",
      "description": "An error becomes an object with name, message and stack in that order",
      "spec_ref": "§4.2",
      "pending": false,
      "input": {
        "value": { "err": { "$error": { "name": "Error", "message": "boom", "stack": "<STACK>" } } }
      },
      "expect": {
        "json": "{\"err\":{\"name\":\"Error\",\"message\":\"boom\",\"stack\":\"<STACK>\"}}"
      }
    },
    {
      "id": "serialization/error-custom-props",
      "description": "Custom properties on an error are preserved after the standard three",
      "spec_ref": "§4.2",
      "pending": false,
      "input": {
        "value": {
          "err": {
            "$error": {
              "name": "HttpError",
              "message": "not found",
              "stack": "<STACK>",
              "props": { "status": 404, "url": "/missing" }
            }
          }
        }
      },
      "expect": {
        "json": "{\"err\":{\"name\":\"HttpError\",\"message\":\"not found\",\"stack\":\"<STACK>\",\"status\":404,\"url\":\"/missing\"}}"
      }
    },
    {
      "id": "serialization/error-non-enumerable",
      "description": "Non-enumerable own properties are still included, distinguishing the two serializers",
      "spec_ref": "§4.2",
      "pending": true,
      "pending_reason": "OQ-3. serializeError spreads only enumerable own properties, so it disagrees with safeStringify on this input.",
      "input": {
        "value": {
          "err": {
            "$error": {
              "name": "Error",
              "message": "hidden",
              "stack": "<STACK>",
              "props": { "code": "E_HIDDEN" },
              "non_enumerable": ["code"]
            }
          }
        }
      },
      "expect": {
        "json": "{\"err\":{\"name\":\"Error\",\"message\":\"hidden\",\"stack\":\"<STACK>\",\"code\":\"E_HIDDEN\"}}"
      }
    },
    {
      "id": "serialization/nested-mixed",
      "description": "Substitutions apply at any depth and inside lists",
      "spec_ref": "§4",
      "pending": false,
      "input": {
        "value": {
          "list": [1, { "$fn": "f" }, { "$undefined": true }],
          "deep": { "deeper": { "s": { "$symbol": "x" } } }
        }
      },
      "expect": {
        "json": "{\"list\":[1,\"[Function: f]\",\"[undefined]\"],\"deep\":{\"deeper\":{\"s\":\"[Symbol: Symbol(x)]\"}}}"
      }
    },
    {
      "id": "serialization/never-throws",
      "description": "A pathological value must not raise; output must remain parseable JSON",
      "spec_ref": "§4",
      "pending": false,
      "input": {
        "value": {
          "$id": "p",
          "value": {
            "cycle": { "$ref": "p" },
            "fn": { "$fn": null },
            "big": { "$bigint": "170141183460469231731687303715884105727" },
            "sym": { "$symbol": "s" },
            "undef": { "$undefined": true }
          }
        }
      },
      "expect": {
        "json": "{\"cycle\":\"[Circular]\",\"fn\":\"[Function: anonymous]\",\"big\":\"[BigInt: 170141183460469231731687303715884105727]\",\"sym\":\"[Symbol: Symbol(s)]\",\"undef\":\"[undefined]\"}"
      }
    }
  ]
}
