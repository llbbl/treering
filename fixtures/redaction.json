{
  "suite": "redaction",
  "spec": "0.1.0-draft",
  "cases": [
    {
      "id": "redaction/defaults",
      "description": "Default key set redacts password, token, secret, key and auth",
      "spec_ref": "§8",
      "pending": false,
      "input": {
        "value": {
          "username": "john",
          "password": "hunter2",
          "token": "abc",
          "secret": "s",
          "key": "k",
          "auth": "bearer x"
        }
      },
      "expect": {
        "json": "{\"username\":\"john\",\"password\":\"[REDACTED]\",\"token\":\"[REDACTED]\",\"secret\":\"[REDACTED]\",\"key\":\"[REDACTED]\",\"auth\":\"[REDACTED]\"}"
      }
    },
    {
      "id": "redaction/case-insensitive",
      "description": "Field name matching ignores case",
      "spec_ref": "§8",
      "pending": false,
      "input": {
        "value": {
          "Password": "x",
          "API_TOKEN": "y",
          "Authorization": "z"
        }
      },
      "expect": {
        "json": "{\"Password\":\"[REDACTED]\",\"API_TOKEN\":\"[REDACTED]\",\"Authorization\":\"[REDACTED]\"}"
      }
    },
    {
      "id": "redaction/substring-overmatch",
      "description": "Token matching does not redact fields that merely contain a sensitive word",
      "spec_ref": "§8.1",
      "pending": false,
      "input": {
        "value": {
          "monkey": "george",
          "keyboard": "qwerty",
          "tokenizer": "bpe"
        }
      },
      "expect": {
        "json": "{\"monkey\":\"george\",\"keyboard\":\"qwerty\",\"tokenizer\":\"bpe\"}"
      },
      "note": "Previously asserted the opposite: under substring matching all three were redacted. The id is kept because ids are stable handles; it names the subject, not the outcome. Resolved by OQ-6."
    },
    {
      "id": "redaction/recurses",
      "description": "Redaction descends into nested maps",
      "spec_ref": "§8",
      "pending": false,
      "input": {
        "value": {
          "user": {
            "name": "j",
            "credentials": {
              "password": "p",
              "id": 1
            }
          }
        }
      },
      "expect": {
        "json": "{\"user\":{\"name\":\"j\",\"credentials\":{\"password\":\"[REDACTED]\",\"id\":1}}}"
      }
    },
    {
      "id": "redaction/preserves-lists",
      "description": "Lists stay lists and their elements are still processed",
      "spec_ref": "§8",
      "pending": false,
      "input": {
        "value": {
          "items": [
            {
              "token": "a"
            },
            {
              "safe": "b"
            }
          ]
        }
      },
      "expect": {
        "json": "{\"items\":[{\"token\":\"[REDACTED]\"},{\"safe\":\"b\"}]}"
      }
    },
    {
      "id": "redaction/custom-keys-replace-defaults",
      "description": "Supplying a key set replaces the defaults rather than extending them",
      "spec_ref": "§8",
      "pending": false,
      "input": {
        "value": {
          "password": "p",
          "ssn": "123"
        },
        "keys": [
          "ssn"
        ]
      },
      "expect": {
        "json": "{\"password\":\"p\",\"ssn\":\"[REDACTED]\"}"
      }
    },
    {
      "id": "redaction/scalars-pass-through",
      "description": "A non-container input is returned unchanged",
      "spec_ref": "§8",
      "pending": false,
      "input": {
        "value": "just a string"
      },
      "expect": {
        "json": "\"just a string\""
      }
    },
    {
      "id": "redaction/not-automatic",
      "description": "The logger must not redact unless the caller explicitly does so",
      "spec_ref": "§8",
      "pending": false,
      "input": {
        "timestamp": "2026-08-22T04:15:30.123Z",
        "runtime": "node",
        "level": "info",
        "message": "login",
        "metadata": {
          "password": "hunter2"
        },
        "format": "json",
        "assert": "no_implicit_redaction"
      },
      "expect": {
        "json": "{\"timestamp\":\"2026-08-22T04:15:30.123Z\",\"level\":\"info\",\"message\":\"login\",\"runtime\":\"node\",\"metadata\":{\"password\":\"hunter2\"}}"
      }
    },
    {
      "id": "redaction/word-boundary-separators",
      "description": "snake_case, camelCase, kebab-case, PascalCase and SCREAMING_SNAKE tokenize identically and all redact",
      "spec_ref": "§8.1",
      "pending": false,
      "input": {
        "value": {
          "api_key": "a",
          "apiKey": "b",
          "API-KEY": "c",
          "API_KEY": "d",
          "ApiKey": "e",
          "x-api-key": "f"
        }
      },
      "expect": {
        "json": "{\"api_key\":\"[REDACTED]\",\"apiKey\":\"[REDACTED]\",\"API-KEY\":\"[REDACTED]\",\"API_KEY\":\"[REDACTED]\",\"ApiKey\":\"[REDACTED]\",\"x-api-key\":\"[REDACTED]\"}"
      },
      "note": "The point of §8.1: an implementation that handles only some of these casings diverges silently."
    },
    {
      "id": "redaction/word-boundary-joined-spellings",
      "description": "Joined spellings in the default key set still redact, because tokenization alone cannot reach them",
      "spec_ref": "§8.2",
      "pending": false,
      "input": {
        "value": {
          "authorization": "a",
          "apikey": "b",
          "authtoken": "c",
          "accesstoken": "d",
          "secretkey": "e"
        }
      },
      "expect": {
        "json": "{\"authorization\":\"[REDACTED]\",\"apikey\":\"[REDACTED]\",\"authtoken\":\"[REDACTED]\",\"accesstoken\":\"[REDACTED]\",\"secretkey\":\"[REDACTED]\"}"
      },
      "note": "These are one lowercase token each, the same shape as 'monkey'. They redact only because §8.2 lists them explicitly. An implementation that drops them from the default set leaks credentials that substring matching used to catch."
    },
    {
      "id": "redaction/word-boundary-plurals",
      "description": "A token matches a key or the key followed by s",
      "spec_ref": "§8.1",
      "pending": false,
      "input": {
        "value": {
          "tokens": "a",
          "keys": "b",
          "passwords": "c",
          "apiKeys": "d",
          "monkeys": "e"
        }
      },
      "expect": {
        "json": "{\"tokens\":\"[REDACTED]\",\"keys\":\"[REDACTED]\",\"passwords\":\"[REDACTED]\",\"apiKeys\":\"[REDACTED]\",\"monkeys\":\"e\"}"
      },
      "note": "monkeys stays: it is not 'key' + s."
    },
    {
      "id": "redaction/word-boundary-digits",
      "description": "Letter/digit boundaries split, so numbered fields still redact",
      "spec_ref": "§8.1",
      "pending": false,
      "input": {
        "value": {
          "key1": "a",
          "token2": "b",
          "api_key_2": "c",
          "sha256": "d"
        }
      },
      "expect": {
        "json": "{\"key1\":\"[REDACTED]\",\"token2\":\"[REDACTED]\",\"api_key_2\":\"[REDACTED]\",\"sha256\":\"d\"}"
      },
      "note": "sha256 splits to sha|256 and matches nothing, confirming digit splitting does not over-match."
    },
    {
      "id": "redaction/custom-keys-get-plurals",
      "description": "The plural rule applies to caller-supplied keys, not only the defaults",
      "spec_ref": "§8.1",
      "pending": false,
      "input": {
        "value": {
          "ssn": "1",
          "ssns": "2",
          "password": "p"
        },
        "keys": [
          "ssn"
        ]
      },
      "expect": {
        "json": "{\"ssn\":\"[REDACTED]\",\"ssns\":\"[REDACTED]\",\"password\":\"p\"}"
      },
      "note": "password is untouched because a supplied key set replaces the defaults."
    }
  ]
}
